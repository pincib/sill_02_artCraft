{
  "$schema": "https://json.schemastore.org/mcp-config.json",
  "description": "ArtCraft MCP Server Configuration Template for Windows, macOS and Linux",
  "mcpServers": {
    "deckcraft": {
      "windows": {
        "command": "C:/Program Files/DeckCraft/deckcraft-cli.exe",
        "args": ["mcp"]
      },
      "macos": {
        "command": "/Applications/DeckCraft.app/Contents/MacOS/deckcraft-cli",
        "args": ["mcp"]
      },
      "linux": {
        "command": "deckcraft-cli",
        "args": ["mcp"]
      }
    },
    "designcraft": {
      "windows": {
        "command": "C:/Program Files/DesignCraft/designcraft-cli.exe",
        "args": ["mcp"]
